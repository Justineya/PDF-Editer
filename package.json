{
  "name": "forgepdf",
  "private": true,
  "version": "0.2.1",
  "description": "ForgePDF — local-first PDF workbench",
  "scripts": {
    "dev": "pnpm --dir apps/web dev",
    "build": "pnpm --dir apps/web build",
    "preview": "pnpm --dir apps/web preview",
    "start": "pnpm --dir apps/web dev --host --port 5173",
    "samples": "NODE_PATH=./apps/web/node_modules node ./scripts/generate-samples.mjs",
    "smoke": "NODE_PATH=./apps/web/node_modules node ./scripts/smoke-ops.mjs",
    "accept": "cd apps/web && node ../../scripts/acceptance-run.mjs",
    "e2e": "node ./scripts/e2e-smoke.mjs",
    "lint": "pnpm --dir apps/web lint",
    "desktop": "pnpm --dir apps/web desktop",
    "desktop:build": "pnpm --dir apps/web desktop:build",
    "fonts:tc": "node ./scripts/fetch-tc-fonts.mjs",
    "samples:phase1": "node ./scripts/gen-phase1-samples.mjs",
    "smoke:phase1": "node --experimental-strip-types ./scripts/smoke-phase1-overlay.mjs",
    "smoke:multiline": "node --experimental-strip-types ./scripts/smoke-multiline-export.mjs",
    "smoke:textlayout": "node --experimental-strip-types ./scripts/smoke-text-layout.mjs",
    "smoke:cluster": "node --experimental-strip-types ./scripts/smoke-address-cluster.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.3"
}
